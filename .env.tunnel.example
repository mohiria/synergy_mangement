# Local development via SSH tunnel to the Tencent Cloud middleware (no local Docker Desktop).
# cp .env.tunnel.example .env.tunnel and fill in the values; .env.tunnel is git-ignored.
# Keep this file ASCII-only: Windows PowerShell 5.1 reads BOM-less UTF-8 as ANSI and a
# non-ASCII comment line can swallow the following newline (the next key is then lost).
#
# Tunnel (run in your own shell, keep it open; IP and password in .env.tencent):
#   ssh -N -L 5432:127.0.0.1:5432 -L 9000:127.0.0.1:9000 -L 3000:127.0.0.1:3000 ubuntu@<server-ip>
#
# Load in PowerShell (repo root):
#   Get-Content .env.tunnel | ? { $_ -match '^[A-Z_]+=' } | % { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
# Load in sh:
#   set -a; . ./.env.tunnel; set +a
# playwright.config.ts loads this file by itself when DATABASE_URL is not already set.
#
# Dev database synergy_dev and bucket synergy-dev ONLY. Never point DATABASE_URL / MINIO_BUCKET
# at the demo database "synergy" / bucket "synergy": seed and e2e wipe all business data.

# Backend (cmd/server, cmd/seed, goose)
DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/synergy_dev?sslmode=disable
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=<MINIO_ROOT_USER>
MINIO_SECRET_KEY=<MINIO_ROOT_PASSWORD>
MINIO_BUCKET=synergy-dev
GOTENBERG_URL=http://127.0.0.1:3000
# Local-only key, 32 bytes: openssl rand -hex 32
APP_SECRET_KEY=<openssl rand -hex 32>

# go test (internal/api integration tests): admin DSN used to create temporary synergy_test_* databases;
# MinIO credentials are read under the compose names, same values as above.
TEST_DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5432/synergy_dev?sslmode=disable
TEST_MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ROOT_USER=<MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<MINIO_ROOT_PASSWORD>
