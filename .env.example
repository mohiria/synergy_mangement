# 部署配置样例：在服务器上 cp .env.example .env 后填真实值（.env 已在 .gitignore，不入库）。
# compose 对下面带「必填」的变量没有默认值，漏填会直接报错，不会用弱密码静默跑起来。

# ── 数据库（必填 POSTGRES_PASSWORD）─────────────────────────────────────────────
POSTGRES_USER=synergy
POSTGRES_PASSWORD=change-me-强密码
POSTGRES_DB=synergy

# ── MinIO（必填 MINIO_ROOT_PASSWORD、MINIO_PUBLIC_ENDPOINT）────────────────────
MINIO_ROOT_USER=synergy
MINIO_ROOT_PASSWORD=change-me-强密码
# 预签名 URL 面向浏览器：必须是内网用户浏览器能直连的地址，填服务器 IP 或主机名，不能是 localhost。
MINIO_PUBLIC_ENDPOINT=192.168.x.x:9000

# ── 对外端口（一般不用改）──────────────────────────────────────────────────────
HTTP_PORT=80
MINIO_PORT=9000

# 本机开发：密码随便填能记住的即可，但要与 go test 默认连接串一致时用 synergy/synergy，
# 或给 go test 显式设 TEST_DATABASE_URL。

# ── 应用密钥（必填 APP_SECRET_KEY）──────────────────────────────────────────────
# 32 字节，hex（64 位）或 base64；用于把 SMTP 密码等敏感配置加密后落库（ADR 0003）。
# 生成：openssl rand -hex 32。缺失时 app 拒绝启动；换密钥后已保存的 SMTP 密码需在系统设置里重新填写。
APP_SECRET_KEY=change-me-openssl-rand-hex-32

